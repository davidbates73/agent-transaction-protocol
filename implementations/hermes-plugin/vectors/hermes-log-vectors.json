      "expected": {
        "verdict": "pass",
        "records": 15,
        "sessions": 2,
        "errors": [],
        "warnings": [
          {
            "line": 15,
            "kind": "unmatched-request",
            "reason": "session sess-main: pre_api_request api_request_id req-3 has no matching post_api_request or api_request_error"
