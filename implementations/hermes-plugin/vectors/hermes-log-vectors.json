    {
      "id": "subagent-linked",
      "description": "Slice 2: v0.23.1-shaped delegation parent -> child -> grandchild; links come from subagent_start onto each child's first record",
      "log": "cases/subagent-linked.jsonl",
      "pub": "TEST-ONLY-key.pub",
      "expected": {
        "verdict": "pass",
        "records": 14,
        "sessions": 3,
        "errors": [],
        "warnings": [],
        "links": [
          {
            "line": 4,
            "parent": "sess-main",
            "child": "sess-child"
          },
          {
            "line": 7,
            "parent": "sess-child",
            "child": "sess-grandchild"
          }
        ]
      }
    },
    {
      "id": "subagent-missing-parent",
      "description": "Slice 2: subagent log with every sess-main record removed: pass, links listed, WARNING missing-parent-session for sess-child",
      "log": "cases/subagent-missing-parent.jsonl",
      "pub": "TEST-ONLY-key.pub",
      "expected": {
        "verdict": "pass",
        "records": 8,
        "sessions": 2,
        "errors": [],
        "warnings": [
