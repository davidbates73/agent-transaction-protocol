      "id": "bodies-valid",
      "description": "Scripted session recorded with log_bodies on (includes a redacted fake key): every stored body re-hashes to its hash",
      "log": "cases/bodies-valid.jsonl",
      "pub": "TEST-ONLY-key.pub",
      "expected": {
        "verdict": "pass",
