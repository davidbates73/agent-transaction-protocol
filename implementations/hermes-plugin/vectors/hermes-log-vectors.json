          },
          {
            "line": 13,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 14,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 15,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 16,
