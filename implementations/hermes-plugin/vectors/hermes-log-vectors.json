    {
      "id": "body-mismatch",
      "description": "log_bodies session; the last record's outputBody changed and the record re-signed with the TEST-ONLY key: authentic but body != outputHash",
      "log": "cases/body-mismatch.jsonl",
      "pub": "TEST-ONLY-key.pub",
      "expected": {
        "verdict": "fail",
        "records": 16,
        "sessions": 2,
        "errors": [
