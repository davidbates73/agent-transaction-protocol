            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 5,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 6,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 7,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 8,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 9,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 10,
            "kind": "tampered",
            "reason": "signature does not verify with the supplied public key"
          },
          {
            "line": 11,
            "kind": "tampered",
