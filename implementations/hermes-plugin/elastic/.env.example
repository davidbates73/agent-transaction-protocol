# Hermes ATP reporting stack -- copy to .env (gitignored), chmod 600, fill in every value.
# Generate passwords/keys with e.g.:  openssl rand -base64 30 | tr -d '/+=' | cut -c1-32
# Never commit .env; never paste these into chat, tickets or the Hermes host.

# Elastic Stack version: the ONE place ES and Kibana are pinned (both images use it, so
# bumping the stack is this one line). Must exist in Kibana's and ES's registries.
STACK_VERSION=9.5.6
COMPOSE_PROJECT_NAME=hermes-atp
CLUSTER_NAME=hermes-atp

# --- credentials -------------------------------------------------------------------
# Superuser `elastic`: used only by setup and for administration on us-solebay.
ELASTIC_PASSWORD=
# Built-in `kibana_system` user (Kibana's own connection to Elasticsearch).
KIBANA_PASSWORD=
# `hermes_exporter`: write-only user for the exporter on nuc-hermes (create_doc on
# hermes-atp-records-* only). Put the same value in the exporter's password file.
HERMES_EXPORTER_PASSWORD=
# `hermes_viewer`: read-only Kibana user for looking at the dashboard.
HERMES_VIEWER_PASSWORD=
# 32+ random characters; encrypts Kibana sessions and saved-object secrets.
KIBANA_ENCRYPTION_KEY=

# --- network -----------------------------------------------------------------------
# Address on us-solebay that Elasticsearch's port 9200 binds to: us-solebay's LAN IP
# (<SOLEBAY_IP>), the one the OPNsense rule allows from nuc-hermes. Avoid 0.0.0.0.
ES_BIND_ADDR=
# Extra names/IPs for the ES certificate (comma-separated); the exporter connects with
# one of them, so it must be listed. e.g. ES_PUBLIC_HOSTNAME=us-solebay.lan  ES_PUBLIC_IP=<SOLEBAY_IP>
ES_PUBLIC_HOSTNAME=
ES_PUBLIC_IP=
# Kibana: keep on localhost (use an SSH tunnel) or a management-network address. Never the
# address reachable from the Hermes VLAN.
KIBANA_BIND_ADDR=127.0.0.1
KIBANA_PUBLIC_HOSTNAME=
KIBANA_PUBLIC_URL=https://localhost:5601

# --- resources (shared host) -------------------------------------------------------
ES_HEAP=1g
ES_MEM_LIMIT=2g
KIBANA_HEAP_MB=1024
KIBANA_MEM_LIMIT=1536m
